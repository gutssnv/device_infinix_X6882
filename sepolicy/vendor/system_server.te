allow system_server sysfs_OTG_STATE_file:file { read write getattr open };
allow system_server sysfs_OTG_CTL_file:file { read write getattr open };
allow system_server sysfs_vibrator:file { read open getattr write };

get_prop(system_server, wifi_hal_prop)

allow system_server sysfs_gpu:file rw_file_perms;

# AxBurstEngine - CPU freq nodes
allow system_server sysfs_devices_system_cpu:file { read write open getattr };

# AxBurstEngine - uclamp via cgroup
allow system_server cgroup:file { read write open getattr };

# AxBurstEngine - GPU GED nodes
allow system_server sysfs_ged:file { read write open getattr };
