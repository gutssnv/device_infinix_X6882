<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CPU Little (cpu0-5, Cortex-A55, max 2000MHz) -->
    <resource id="0x0001" name="cpu_min_little"
              path="/sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq" default="500000" />
    <resource id="0x0002" name="cpu_max_little"
              path="/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq" default="2000000" />

    <!-- CPU Big (cpu6-7, Cortex-A76, max 2200MHz) -->
    <resource id="0x0003" name="cpu_min_big"
              path="/sys/devices/system/cpu/cpu6/cpufreq/scaling_min_freq" default="725000" />
    <resource id="0x0004" name="cpu_max_big"
              path="/sys/devices/system/cpu/cpu6/cpufreq/scaling_max_freq" default="2200000" />

    <!-- uclamp via cgroup -->
    <resource id="0x0014" name="uclamp_top_min"
              path="/dev/cpuctl/top-app/cpu.uclamp.min" default="0" />
    <resource id="0x0015" name="uclamp_top_max"
              path="/dev/cpuctl/top-app/cpu.uclamp.max" default="100" />

    <!-- GPU (GED OPP index: 0=1100MHz, 43=390MHz) -->
    <resource id="0x0030" name="gpu_boost_opp"
              path="/sys/kernel/ged/hal/custom_boost_gpu_freq" default="37" />
    <resource id="0x0031" name="gpu_upbound_opp"
              path="/sys/kernel/ged/hal/custom_upbound_gpu_freq" default="0" />
</resources>
